{
  "name": "photocopier-ui",
  "version": "0.1.0",
  "description": "A color photocopy overlay and copier-style sheet transitions for web apps. Two parts, usable separately.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./overlay": "./src/overlay.js",
    "./sheets": "./src/sheets.js",
    "./dist/*": "./dist/*"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/serve.js"
  },
  "keywords": [
    "photocopy",
    "xerox",
    "scanner",
    "overlay",
    "transition",
    "modal",
    "retro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volonterx/photocopier-ui.git"
  },
  "homepage": "https://volonterx.github.io/photocopier-ui/",
  "sideEffects": false
}
